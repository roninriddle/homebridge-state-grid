{
  "pluginAlias": "StateGrid",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "把「网上国网」的用电数据以摄像头卡片的形式显示在 Apple 家庭。插件直接调用国家电网 App 接口，不需要 Home Assistant、Python 或额外容器。",
  "footerDisplay": "非官方插件，依赖网上国网 App 的非公开接口，服务端升级后可能暂时失效。请勿用于计费或结算。",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "名称",
        "type": "string",
        "default": "国家电网",
        "description": "在 Homebridge 日志里显示的平台名称。"
      },
      "username": {
        "title": "手机号",
        "type": "string",
        "description": "网上国网登录手机号。"
      },
      "password": {
        "title": "密码",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        },
        "description": "留空则使用首次登录时保存的凭据。凭据会以加密方式保存在插件私有目录，不写入 config.json 的备份里。"
      },
      "updateIntervalHours": {
        "title": "更新间隔（小时）",
        "type": "integer",
        "default": 12,
        "minimum": 6,
        "maximum": 24,
        "description": "国家电网的日用电数据本身是延迟发布的，查询过于频繁没有意义，也更容易触发风控。"
      },
      "showRegion": {
        "title": "显示卡片顶部的省市区",
        "type": "boolean",
        "default": false,
        "description": "默认隐藏地区；也可在卡片指标页按户号单独设置。"
      },
      "theme": {
        "title": "卡片主题",
        "type": "string",
        "default": "light",
        "oneOf": [
          { "title": "浅色", "enum": ["light"] },
          { "title": "深色", "enum": ["dark"] }
        ]
      },
      "snapshotWidth": {
        "title": "卡片宽度（像素）",
        "type": "integer",
        "default": 1280,
        "minimum": 640,
        "maximum": 3840,
        "description": "HomeKit 快照的渲染宽度。1280 足够清晰，加大只会增加渲染耗时。"
      },
      "snapshotHeight": {
        "title": "卡片高度（像素）",
        "type": "integer",
        "default": 720,
        "minimum": 360,
        "maximum": 2160
      },
      "fields": {
        "title": "卡片指标",
        "type": "array",
        "description": "按显示顺序列出卡片指标：第 1 项是主数字，第 2 项与其并列，其余进入下方网格。删除某行 = 不显示该指标；拖拽调整顺序 = 改变位置。",
        "default": [
          { "key": "balance" },
          { "key": "monthEstimateCharge" },
          { "key": "currentMonthUsage" },
          { "key": "latestDailyUsage" },
          { "key": "latestPeakUsage" },
          { "key": "latestValleyUsage" },
          { "key": "latestFlatUsage" },
          { "key": "latestSharpUsage" },
          { "key": "latestMonthUsage" },
          { "key": "latestMonthCharge" },
          { "key": "currentYearUsage" },
          { "key": "currentYearCharge" }
        ],
        "items": {
          "type": "object",
          "title": "指标",
          "properties": {
            "key": {
              "title": "指标",
              "type": "string",
              "oneOf": [
                { "title": "账户余额 / 应交电费", "enum": ["balance"] },
                { "title": "本月预估电费", "enum": ["monthEstimateCharge"] },
                { "title": "当月用电", "enum": ["currentMonthUsage"] },
                { "title": "上日用电", "enum": ["latestDailyUsage"] },
                { "title": "上日峰用电", "enum": ["latestPeakUsage"] },
                { "title": "上日谷用电", "enum": ["latestValleyUsage"] },
                { "title": "上日平用电", "enum": ["latestFlatUsage"] },
                { "title": "上日尖用电", "enum": ["latestSharpUsage"] },
                { "title": "上月用电", "enum": ["latestMonthUsage"] },
                { "title": "上月电费", "enum": ["latestMonthCharge"] },
                { "title": "年累计用电", "enum": ["currentYearUsage"] },
                { "title": "年累计电费", "enum": ["currentYearCharge"] },
                { "title": "当月峰用电", "enum": ["monthPeakUsage"] },
                { "title": "当月谷用电", "enum": ["monthValleyUsage"] },
                { "title": "当月平用电", "enum": ["monthFlatUsage"] },
                { "title": "当月尖用电", "enum": ["monthSharpUsage"] },
                { "title": "当前阶梯", "enum": ["ladderLevel"] },
                { "title": "违约金", "enum": ["penalty"] },
                { "title": "历史欠费", "enum": ["historyOwe"] }
              ]
            }
          }
        }
      },
      "accounts": {
        "title": "户号",
        "type": "array",
        "description": "留空则自动为账号下所有户号创建卡片。添加一行并填入户号后，可为该户号单独设置标题与是否启用。户号可在插件的「户号与卡片预览」页读取。",
        "items": {
          "type": "object",
          "properties": {
            "consNo": {
              "title": "户号",
              "type": "string",
              "description": "网上国网里的用电户号（未加密形式）。"
            },
            "title": {
              "title": "显示名称",
              "type": "string",
              "description": "摄像头显示名称，默认“国家电网”。多个户号可以分别命名，不使用户号或地区作为默认名称。"
            },
            "showRegion": {
              "title": "显示省市区",
              "type": "boolean",
              "description": "不设置则继承全局设置；卡片指标页按户号保存的设置优先。"
            },
            "enabled": {
              "title": "启用",
              "type": "boolean",
              "default": true,
              "description": "关闭后该户号不会生成摄像头卡片。"
            }
          }
        }
      }
    },
    "required": ["username"]
  },
  "layout": [
    "name",
    "username",
    "password",
    "updateIntervalHours",
    "theme",
    "showRegion",
    "snapshotWidth",
    "snapshotHeight",
    {
      "key": "accounts",
      "type": "tabarray",
      "title": "{{ value.title || value.consNo || '新户号' }}",
      "expandable": true,
      "expanded": false,
      "orderable": true,
      "items": [
        "accounts[].consNo",
        "accounts[].title",
        "accounts[].showRegion",
        "accounts[].enabled"
      ]
    }
  ]
}
